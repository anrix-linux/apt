#!/bin/sh
set -e

TESTDIR="$(readlink -f "$(dirname "$0")")"
. "$TESTDIR/framework"

setupenvironment
configarchitecture "i386"

insertpackage 'unstable' 'foo' 'all' '2.0'
insertpackage 'unstable' 'phased' 'all' '2.0' 'Phased-Update-Percentage: 0'
insertinstalledpackage 'foo' 'all' '1.0'
insertinstalledpackage 'phased' 'all' '1.0'

setupaptarchive --no-update

testfailuremsg 'E: The update command takes no arguments' apt update arguments

testempty apt update -qq -o pkgCacheFile::Generate=false
testsuccessequal "1 package is held back due to phasing.\n1 package can be upgraded. Run 'apt list --upgradable' to see it." apt update -qq

rm -f rootdir/var/lib/dpkg/status
insertinstalledpackage 'foo' 'all' '2.0'
insertinstalledpackage 'phased' 'all' '2.0'
testsuccessequal 'All packages are up to date.' apt update -qq

insertpackage 'unstable' 'phased' 'all' '3.0' 'Phased-Update-Percentage: 0'
setupaptarchive --no-update
testsuccessequal "1 package is held back due to phasing." apt update -qq
